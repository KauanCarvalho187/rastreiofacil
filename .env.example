# Copie para .env e preencha. NUNCA commite o .env real.
# Banco Postgres (Neon, Supabase, Railway, Render...). Sem ele, usa SQLite local.
DATABASE_URL=postgresql://usuario:senha@host:5432/banco?sslmode=require
# Porta local / Render injeta PORT automaticamente
PORT=3000
# E-mail (Gmail com senha de app)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seuemail@gmail.com
SMTP_PASS=sua-senha-de-app
SENDER_NAME=Rastreio Facil
SESSAO_DIAS=7
# --- v20 (melhorias) ---
# CORS restrito em producao (separado por virgula).
# v31: o padrao NAO e mais "*" — sem esta variavel vale a lista local de dev
# (app :3000/:8080, Live Server :5500-5503 e file://). Em producao, ponha seu dominio:
# CORS_ORIGINS=https://app.seu-dominio.com,https://seu-dominio.com
CORS_ORIGINS=
# Anti brute-force no login: max tentativas por IP na janela
LOGIN_MAX_TENT=10
LOGIN_JANELA_SEG=300
# --- v28: admin unico ---
# O sistema tem UMA conta de acesso. O e-mail abaixo e o unico que entra.
ADMIN_EMAIL=admin@admin.com
ADMIN_NOME=Admin
# Senha inicial (usada só na 1a vez, quando a conta ainda não existe).
# Depois de criada, troque a senha pela tela — este valor é ignorado.
# v31: em PRODUCAO (com DATABASE_URL/Postgres) esta variavel e OBRIGATORIA: sem ela
# o admin nao e criado. Em desenvolvimento local (SQLite) o padrao e "admin12345".
ADMIN_SENHA=troque-esta-senha-por-favor
# --- v23: rastreio automatico (API Site Rastreio / Wonca Labs) ---
# Chave em https://labs.wonca.com.br - plano gratis: 1000 consultas/mes. Sem ela, "Rastrear" abre so o site dos Correios.
RASTREIO_API_KEY=
# Minutos em que cada consulta fica em cache (economiza a cota)
RASTREIO_CACHE_MIN=30
