# Copie para .env e preencha. NUNCA commite o .env real.
# Banco Postgres (Neon, Supabase, Railway, Render...). Sem ele, usa SQLite local.
DATABASE_URL=postgresql://usuario:senha@host:5432/banco?sslmode=require
# Porta local / Render injeta PORT automaticamente
PORT=3000
# E-mail (Gmail com senha de app)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seuemail@gmail.com
SMTP_PASS=sua-senha-de-app
SENDER_NAME=Rastreio Facil
SESSAO_DIAS=7
# --- v20 (melhorias) ---
# CORS restrito em producao (separado por virgula). Padrao * mantem Live Server/file:// funcionando.
CORS_ORIGINS=*
# Anti brute-force no login: max tentativas por IP na janela
LOGIN_MAX_TENT=10
LOGIN_JANELA_SEG=300

